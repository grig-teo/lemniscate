generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GitProvider {
  github
  gitverse
  gitlab
  gitee
}

enum ThinkingLevel {
  off
  low
  medium
  high
}

enum TaskKind {
  proposal
  prompt
}

enum TaskStatus {
  pending
  queued
  running
  awaiting_review
  done
  failed
  closed
}

enum TaskEventKind {
  log
  diff
  status
}

model User {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  // Session revocation: JWTs embed the sessionVersion they were issued at
  // (`sv` claim); a mismatch (logout, last git connection removed) 401s.
  sessionVersion Int             @default(0)
  gitConnections GitConnection[]
  llmConfigs     LlmConfig[]
  skills         Skill[]
  mcpServers     McpServer[]
  devices        Device[]
  devicePairings DevicePairing[]
  notifications  Notification[]
  notificationSettings NotificationSetting[]
  vpsTargets     VpsTarget[]
}

model GitConnection {
  id             String       @id @default(cuid())
  userId         String
  provider       GitProvider
  baseUrl        String?
  username       String
  // Soft disconnect: the row (with repositories, tasks, and configuration)
  // is kept so reconnecting restores everything; only the stored tokens are
  // scrubbed (accessTokenEnc set to null) and disconnectedAt is stamped.
  accessTokenEnc String?
  // How the stored token authenticates: 'pat' (GitLab PRIVATE-TOKEN header)
  // or 'oauth' (Authorization: Bearer). GitHub/GitVerse ignore this.
  tokenType      String?      @default("pat")
  // GitLab OAuth tokens expire (~2h): the encrypted refresh token and the
  // access-token expiry (with a safety margin) let us refresh before calls
  // start failing with 401. Null for GitHub/GitVerse and PAT connections.
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  // Null = active. Set when the user disconnects; cleared on reconnect.
  disconnectedAt DateTime?
  // Encrypted shared secret for inbound webhook verification. When set, the
  // POST /api/webhooks/:connectionId endpoint verifies the provider's signature
  // against this secret; when null, the endpoint answers 401 and the 5-min
  // pr-state-sync poller remains the only source of PR-state transitions.
  webhookSecretEnc String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories   Repository[]

  // One row per PAT/OAuth identity; NULLS NOT DISTINCT enforced in the
  // migration SQL so github/gitlab rows (baseUrl NULL) cannot duplicate.
  @@unique([provider, username, baseUrl])
  @@index([userId])
}

model LlmConfig {
  id                String        @id @default(cuid())
  userId            String
  name              String
  baseUrl           String
  apiKeyEnc         String
  model             String
  thinkingLevel     ThinkingLevel @default(off)
  temperature       Float         @default(0.2)
  maxTokens         Int
  contextWindow     Int
  systemPromptExtra String?
  timeoutSeconds    Int           @default(120)
  maxRetries        Int           @default(3)
  requestsPerMinute Int
  maxTokensPerRun   Int?
  // Optional user-entered USD prices per million tokens; both must be set
  // for the API/UI to show estimated costs (absent, never guessed).
  inputPricePerMillion  Float?
  outputPricePerMillion Float?
  customHeaders     Json          @default("{}")
  isDefault         Boolean       @default(false)
  enabled           Boolean       @default(true)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories      Repository[]  @relation("RepositoryLlm")
  reviewRepositories Repository[] @relation("RepositoryReviewLlm")
  tasks             Task[]

  @@index([userId])
}

model Repository {
  id            String       @id @default(cuid())
  connectionId  String
  externalId    String
  name          String
  fullName      String
  cloneUrl      String
  defaultBranch String
  autoPropose   Boolean      @default(false)
  autoCreatePr  Boolean      @default(true)
  // autoMergePr requires autoReviewPr: a PR is only merged after the LLM
  // review approves it (enforced in the PATCH route).
  autoReviewPr  Boolean      @default(false)
  autoMergePr   Boolean      @default(false)
  // proposals-autorun job (every 20 min) starts pending proposals one at a
  // time per repo when this is on; default off.
  autoRunProposals Boolean   @default(false)
  hidden        Boolean      @default(false)
  // Slugs of skills (Skill model) injected into the agent's system prompt
  // for tasks on this repository; string[] stored as JSON.
  skillSlugs    Json?
  // Skill row (kind 'agents_md') whose content is written as AGENTS.md when
  // the cloned repo root lacks one.
  agentsMdSkillId String?
  // bare = near-empty repository (README-only, no implementation), refreshed
  // on every repo sync; a failed check keeps the previous value.
  bare          Boolean      @default(false)
  // Detected app platform ('android'|'ios'|'web'|'desktop'|'unknown'),
  // refreshed on every repo sync from the provider root listing; null until
  // the first successful detection (see lib/repo-platform.ts).
  platform      String?
  llmConfigId   String?
  // LLM config used by the review-pr job (review + fix iterations); null =
  // the standard resolution (task → repo llmConfigId → user default).
  reviewLlmConfigId String?
  connection    GitConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  llmConfig     LlmConfig?    @relation("RepositoryLlm", fields: [llmConfigId], references: [id], onDelete: SetNull)
  reviewLlmConfig LlmConfig?  @relation("RepositoryReviewLlm", fields: [reviewLlmConfigId], references: [id], onDelete: SetNull)
  tasks         Task[]
  service       Service?

  @@unique([connectionId, externalId])
  @@index([llmConfigId])
  @@index([reviewLlmConfigId])
}

model Task {
  id           String      @id @default(cuid())
  repositoryId String
  kind         TaskKind
  title        String
  // Proposal category label ('security', 'ux/ui', 'testing', …) from
  // PROPOSAL_CATEGORIES in agent-prompts.ts; null for prompt tasks and
  // proposals created before this column existed.
  category     String?
  // Proposal priority ('critical'|'high'|'medium'|'low') and effort size
  // ('small'|'medium'|'large') from the generator prompt; null for prompt
  // tasks and proposals created before these columns existed.
  priority     String?
  effort       String?
  prompt       String?
  status       TaskStatus  @default(pending)
  branchName   String?
  prUrl        String?
  llmConfigId  String?
  // Per-task thinking-level override ('low'|'medium'|'high'|'max'); null =
  // use the LLM config's level. Stored as TEXT, validated by zod at the API.
  thinkingLevel String?
  // Image attachments sent with the prompt: [{name, dataUrl}] (max 3).
  attachments  Json?
  // Slugs of skills (Skill model) injected into the agent's system prompt
  // for this run; string[] stored as JSON. Null = repository default.
  skills       Json?
  // MCP servers attached to this run: { "<slug>": <config> } — materialized
  // as .mcp.json in the workdir before the agent starts.
  mcpServers   Json?
  // Per-folder AGENTS.md attachments: [{ "folder": "src/api", "content": "..." }]
  // — written into the workdir before the agent starts.
  agentsMdFiles Json?
  // Cumulative LLM token usage across run/review/fix jobs; seeds the
  // maxTokensPerRun budget so it spans the whole task, not a single job.
  llmTokensUsed Int        @default(0)
  // Cumulative prompt/completion split backing cost estimates; NULL for
  // tasks that ran before these columns existed (estimates cover new runs
  // only — no fabricated backfill).
  llmPromptTokens     Int?
  llmCompletionTokens Int?
  // Repo-relative paths changed on the task branch (string[] as JSON),
  // recorded by the worker after the push; null for old tasks or when the
  // diff failed (run-targets falls back to the repository platform).
  changedPaths Json?
  error        String?
  // Structured error code from the classifyError() mapping (errors.ts);
  // null for tasks that succeeded or haven't run yet. The frontend maps
  // these codes to user-friendly banners with actionable hints.
  errorCode    String?
  // Soft-archive timestamp: archived tasks are hidden from task lists but
  // never deleted; null = active.
  archivedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  llmConfig    LlmConfig?  @relation(fields: [llmConfigId], references: [id], onDelete: SetNull)
  events       TaskEvent[]

  @@index([repositoryId])
  @@index([status])
  @@index([llmConfigId])
}

model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  content     String
  tags        String[]
  source      String   @default("hermes")
  // 'skill' = injectable instruction pack; 'agents_md' = AGENTS.md template.
  kind        String   @default("skill")
  // Owner for user-created rows; NULL = global seeded entry readable by all.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// MCP server library entry: `config` holds the server fragment that is
// materialized into `.mcp.json` ("mcpServers": { "<slug>": <config> }) when
// selected during repository creation.
model McpServer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  config      Json
  tags        String[]
  source      String   @default("lemniscate")
  // Owner for user-created rows; NULL = global seeded entry readable by all.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TaskEvent {
  id        String        @id @default(cuid())
  taskId    String
  createdAt DateTime      @default(now())
  kind      TaskEventKind
  payload   Json
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// A paired local device (companion agent). Connects OUTBOUND to the
// WebSocket gateway (/api/devices/ws); the server pushes DeviceCommands
// through that tunnel. Only the sha256 of the device token is stored.
model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  // 'android'|'ios'|'desktop'|'web' — TEXT, validated by zod at the API.
  platform   String
  // Agent-reported capabilities: os, arch, agentVersion, dockerAvailable, …
  meta       Json?
  tokenHash  String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands   DeviceCommand[]

  @@index([userId])
}

// Short-lived (10 min) 6-char code the user creates in the UI; the device
// agent exchanges it for a device token via POST /api/devices/claim.
model DevicePairing {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  // 'run_web'|'run_ios'|'run_desktop'|'install_apk'|'build_android' — TEXT,
  // validated by zod at the API.
  type      String
  payload   Json
  // queued|sent|running|done|failed — TEXT, transitions via the WS gateway.
  status    String   @default("queued")
  result    Json?
  // Optional link to the task this command runs the result of (plain
  // column, no FK — the command must survive the task being touched).
  taskId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([taskId])
}

// User-facing notification for async agent events (PR opened/merged/closed,
// run failed, token budget exceeded). Emitted by lib/notifications.ts from
// the existing event producers; read via GET /api/notifications and the
// TopNav bell. `kind` is TEXT ('pr_opened'|'pr_merged'|'pr_closed'|
// 'run_failed'|'budget_exceeded'), validated in lib/notifications.ts.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  taskId    String?
  prUrl     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Outbound notification channel (AGENTS.md §6 single home for delivery
// config): a webhook URL POSTed HMAC-signed JSON, or an email address
// reached via the optional SMTP_* env config. `channel` is TEXT
// ('webhook'|'email'), `events` the subscribed Notification.kind list —
// both validated in lib/notifications.ts. `secretEnc` holds the webhook
// HMAC secret, AES-256-GCM at rest via lib/crypto.ts (null for email).
model NotificationSetting {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  target    String
  secretEnc String?
  events    String[]
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([userId])
}

// Audit log of outbound delivery attempts: one row per (setting, event)
// enqueue, updated by the 'notification-delivery' BullMQ job with attempts,
// last HTTP status/error, and the terminal status ('queued'|'delivered'|
// 'failed'|'skipped'). `payload` is the exact JSON body sent.
model NotificationDelivery {
  id             String   @id @default(cuid())
  settingId      String
  notificationId String?
  event          String
  status         String   @default("queued")
  attempts       Int      @default(0)
  lastStatusCode Int?
  lastError      String?
  payload        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  setting        NotificationSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@index([settingId, createdAt])
}

enum ServiceStatus {
  stopped
  deploying
  online
  failed
}

enum DeployStatus {
  queued
  building
  starting
  checking
  online
  failed
}

// Where a Service is deployed. 'lemniscate' runs the app in a container on
// the platform's isolated apps network (Traefik-routed). 'vps' ships the
// build over SSH to the user's own server (referenced by vpsTargetId).
enum DeployTarget {
  lemniscate
  vps
}

// Reusable SSH connection profile for a user's own VPS. One profile can back
// several services. The credential (password or private key) is AES-256-GCM
// encrypted at rest and decrypted only into the SSH invocation at deploy time;
// it is never returned over the API.
model VpsTarget {
  id           String   @id @default(cuid())
  userId       String
  // Display name the user picks (e.g. "prod-box"); not used for routing.
  name         String
  host         String
  port         Int      @default(22)
  username     String
  // 'password' or 'key' — which credential secretEnc holds.
  authMethod   String   @default("password")
  // Encrypted password (authMethod='password') or PEM private key
  // (authMethod='key'). Never returned by the API (only hasSecret: true).
  secretEnc    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]

  @@index([userId])
}

// One deployable service per repository (v1), reachable at
// https://apps.grig-teo.space/<connection.username>/<name> when deployed on
// Lemniscate. Deployed by the worker's 'deploy-service' job — either into a
// container on the isolated apps network (lemniscate) or over SSH onto the
// user's VPS (vps). Traefik routes lemniscate services via the backend's
// dynamic-config endpoint.
model Service {
  id           String        @id @default(cuid())
  repositoryId String        @unique
  // URL slug segment (lowercase [a-z0-9-]); unique per connection username,
  // enforced in the route (the pair forms the public path).
  name         String
  // Container port the app listens on (Traefik target port).
  port         Int           @default(80)
  // Distinct host port published on a VPS (docker -p left side). Allocated
  // per-service so two apps with the same container port don't collide on the
  // host. Null for lemniscate services (Traefik routes by container name).
  hostPort     Int?
  // Per-service env vars, AES-256-GCM encrypted JSON {KEY: value}; decrypted
  // only into `docker run --env` at deploy time, never logged.
  envEnc       String?
  autoDeploy   Boolean       @default(true)
  status       ServiceStatus @default(stopped)
  // Currently routed container name (blue/green flip target); null when
  // nothing is deployed. For VPS deploys this holds the remote container name.
  activeContainer String?
  // Where the service is deployed. Defaults to 'lemniscate' (platform apps
  // network); 'vps' ships the build to the user's own server over SSH.
  deployTarget DeployTarget  @default(lemniscate)
  // Required when deployTarget='vps'; must be null otherwise (enforced in the
  // route). onDelete: SetNull so deleting a VPS profile falls services back to
  // the lemniscate target rather than orphaning them.
  vpsTargetId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  repository   Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  vpsTarget    VpsTarget?    @relation(fields: [vpsTargetId], references: [id], onDelete: SetNull)
  deployments  Deployment[]
}

model Deployment {
  id         String       @id @default(cuid())
  serviceId  String
  // Merge that triggered this deploy; null for manual redeploys.
  taskId     String?
  commitSha  String
  status     DeployStatus @default(queued)
  // Capped log tail (build/run/health output), ~50KB.
  log        String       @default("")
  createdAt  DateTime     @default(now())
  finishedAt DateTime?
  service    Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}
