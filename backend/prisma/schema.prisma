generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GitProvider {
  github
  gitverse
  gitlab
  gitee
  gitlem
}

enum ThinkingLevel {
  off
  low
  medium
  high
}

enum TaskKind {
  proposal
  prompt
}

enum TaskStatus {
  pending
  queued
  running
  // lemcore plan mode (Repository.planMode): the loop paused after its
  // first-turn plan until the user approves or rejects it.
  awaiting_plan_approval
  awaiting_review
  reviewing_code
  done
  failed
  closed
}

enum TaskEventKind {
  log
  diff
  status
  agent_step
  retrospective
}

model User {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  // Session revocation: JWTs embed the sessionVersion they were issued at
  // (`sv` claim); a mismatch (logout, last git connection removed) 401s.
  sessionVersion Int             @default(0)
  // Core agent override (Settings → Agent): null = deployment default
  // (AGENT_EXECUTOR env). 'hermes' runs the Hermes CLI; 'internal' the
  // built-in single-shot LLM loop. Resolved by lib/agent-executor.ts.
  agentExecutor  String?
  // Phase 12 quotas: null = unlimited. Configurable per-user monthly caps;
  // enforced by lib/quota.ts before a task is enqueued (tasks) and at the
  // LLM-call layer (tokens).
  monthlyTokenQuota Int?
  monthlyTaskQuota  Int?
  gitConnections GitConnection[]
  llmConfigs     LlmConfig[]
  skills         Skill[]
  mcpServers     McpServer[]
  devices        Device[]
  devicePairings DevicePairing[]
  notifications  Notification[]
  notificationSettings NotificationSetting[]
  vpsTargets     VpsTarget[]
  gitlemUser     GitlemUser?
  apiTokens      ApiToken[]
  orgMemberships OrgMember[]
  oauthIdentities OauthIdentity[]
  usageSnapshots  UsageSnapshot[]
  ownedMarketplaceListings MarketplaceListing[] @relation("MarketplaceOwner")
}

model GitConnection {
  id             String       @id @default(cuid())
  userId         String
  provider       GitProvider
  baseUrl        String?
  username       String
  // Soft disconnect: the row (with repositories, tasks, and configuration)
  // is kept so reconnecting restores everything; only the stored tokens are
  // scrubbed (accessTokenEnc set to null) and disconnectedAt is stamped.
  accessTokenEnc String?
  // How the stored token authenticates: 'pat' (GitLab PRIVATE-TOKEN header)
  // or 'oauth' (Authorization: Bearer). GitHub/GitVerse ignore this.
  tokenType      String?      @default("pat")
  // GitLab OAuth tokens expire (~2h): the encrypted refresh token and the
  // access-token expiry (with a safety margin) let us refresh before calls
  // start failing with 401. Null for GitHub/GitVerse and PAT connections.
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  // Null = active. Set when the user disconnects; cleared on reconnect.
  disconnectedAt DateTime?
  // Encrypted shared secret for inbound webhook verification. When set, the
  // POST /api/webhooks/:connectionId endpoint verifies the provider's signature
  // against this secret; when null, the endpoint answers 401 and the 5-min
  // pr-state-sync poller remains the only source of PR-state transitions.
  webhookSecretEnc String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories   Repository[]

  // One row per PAT/OAuth identity; NULLS NOT DISTINCT enforced in the
  // migration SQL so github/gitlab rows (baseUrl NULL) cannot duplicate.
  @@unique([provider, username, baseUrl])
  @@index([userId])
}

model LlmConfig {
  id                String        @id @default(cuid())
  userId            String
  name              String
  baseUrl           String
  apiKeyEnc         String
  model             String
  // Transport pattern: 'openai' (chat completions) or 'anthropic' (Messages
  // API) — TEXT with a default so rows predating the column read as openai.
  apiPattern        String        @default("openai")
  // Provider preset id from the registry ('openai'|'anthropic'|'zai'|'kimi'|
  // 'grok'); null for custom endpoints (lib/llm-providers.ts).
  provider          String?
  // Credential source: 'api_key' (pasted secret) or 'oauth' (device-code
  // login; access token in apiKeyEnc, refresh in refreshTokenEnc).
  authType          String        @default("api_key")
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  // Cached OIDC token_endpoint for oauth refresh (must stay on *.x.ai).
  oauthTokenEndpoint String?
  thinkingLevel     ThinkingLevel @default(off)
  temperature       Float         @default(0.2)
  maxTokens         Int
  contextWindow     Int
  systemPromptExtra String?
  timeoutSeconds    Int           @default(120)
  maxRetries        Int           @default(3)
  requestsPerMinute Int
  // Phase 12: owning organization; null = the creating user's personal org.
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  maxTokensPerRun   Int?
  // Optional user-entered USD prices per million tokens; both must be set
  // for the API/UI to show estimated costs (absent, never guessed).
  inputPricePerMillion  Float?
  outputPricePerMillion Float?
  customHeaders     Json          @default("{}")
  isDefault         Boolean       @default(false)
  enabled           Boolean       @default(true)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories      Repository[]  @relation("RepositoryLlm")
  reviewRepositories Repository[] @relation("RepositoryReviewLlm")
  tasks             Task[]

  @@index([userId])
}

model Repository {
  id            String       @id @default(cuid())
  connectionId  String
  externalId    String
  name          String
  fullName      String
  cloneUrl      String
  defaultBranch String
  autoPropose   Boolean      @default(false)
  autoCreatePr  Boolean      @default(true)
  // autoMergePr requires autoReviewPr: a PR is only merged after the LLM
  // review approves it (enforced in the PATCH route).
  autoReviewPr  Boolean      @default(false)
  autoMergePr   Boolean      @default(false)
  // proposals-autorun job (every 20 min) starts pending proposals one at a
  // time per repo when this is on; default off.
  autoRunProposals Boolean   @default(false)
  // Human PR review feedback loop: when on, a human review comment on an
  // agent-authored PR enqueues an address-review job (agent fixes the code
  // and pushes to the same branch). Default off — the product's mission is
  // to not intervene in the autonomous loop unless a repo opts in.
  autoAddressReview Boolean @default(false)
  hidden        Boolean      @default(false)
  // Phase 10: bash routing to a paired device. deviceId of a paired Device;
  // deviceRouteWhen: 'always' (all bash steps go to the device; offline →
  // clear error, never a silent local fallback) | 'on-demand' (only when the
  // agent picks the run_on_device tool).
  deviceRouteId   String?
  deviceRouteWhen String  @default("on-demand")
  // Phase 11: semantic code index (pgvector) feature flag; off = the
  // classic static repo-context builder is used.
  semanticIndex   Boolean @default(false)
  // Phase 12: owning organization; null = user's personal repo. Org rows are
  // auto-created for existing users ('personal' kind) by migration 0039.
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  marketplaceInstalls MarketplaceInstall[]
  webhooks             Webhook[]
  // Slugs of skills (Skill model) injected into the agent's system prompt
  // for tasks on this repository; string[] stored as JSON.
  skillSlugs    Json?
  // Skill row (kind 'agents_md') whose content is written as AGENTS.md when
  // the cloned repo root lacks one.
  agentsMdSkillId String?
  // bare = near-empty repository (README-only, no implementation), refreshed
  // on every repo sync; a failed check keeps the previous value.
  bare          Boolean      @default(false)
  // Detected app platform ('android'|'ios'|'web'|'desktop'|'unknown'),
  // refreshed on every repo sync from the provider root listing; null until
  // the first successful detection (see lib/repo-platform.ts).
  platform      String?
  llmConfigId   String?
  // LLM config used by the review-pr job (review + fix iterations); null =
  // the standard resolution (task → repo llmConfigId → user default).
  reviewLlmConfigId String?
  // lemcore plan mode: the loop's first turn must produce a step plan and
  // pauses in 'awaiting_plan_approval' until the user approves/rejects it.
  planMode Boolean @default(false)
  // lemcore tool approval: mutating tool calls (bash/write_file/edit_file)
  // pause in awaiting_approval until the user approves/denies them.
  requireToolApproval Boolean @default(false)
  // Optional lemcore per-round model routing: planning/verification rounds
  // use plannerLlmConfigId, edit rounds editorLlmConfigId; null = the
  // standard resolution. Failover still spans all enabled user configs.
  plannerLlmConfigId String?
  editorLlmConfigId  String?
  // Autonomous pipeline health: last successful generate-proposals run and
  // the last error message (scrubbed). Null until the first attempt; the
  // frontend shows a green/amber/red dot based on these (see RepoRow.tsx).
  lastProposalAt    DateTime?
  lastProposalError String?
  connection    GitConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  llmConfig     LlmConfig?    @relation("RepositoryLlm", fields: [llmConfigId], references: [id], onDelete: SetNull)
  reviewLlmConfig LlmConfig?  @relation("RepositoryReviewLlm", fields: [reviewLlmConfigId], references: [id], onDelete: SetNull)
  tasks         Task[]
  eventTriggers EventTrigger[]
  service       Service?
  executorRunStats ExecutorRunStat[]

  @@unique([connectionId, externalId])
  @@index([llmConfigId])
  @@index([reviewLlmConfigId])
}

// Event-driven task triggers: maps an inbound webhook event kind to a task
// prompt. When the webhook receiver gets a ci_failed or issue_opened event for
// a repository, it checks for a matching enabled EventTrigger and creates +
// enqueues a prompt task using taskPrompt as the instruction.
model EventTrigger {
  id           String   @id @default(cuid())
  repositoryId String
  // 'ci_failed' | 'issue_opened' — the webhook event kind that fires this trigger.
  eventKind    String
  // The prompt injected into the created task (becomes the task.prompt).
  taskPrompt   String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  // One trigger per event kind per repository.
  @@unique([repositoryId, eventKind])
  @@index([repositoryId])
}

model Task {
  id           String      @id @default(cuid())
  repositoryId String
  kind         TaskKind
  title        String
  // Proposal category label ('security', 'ux/ui', 'testing', …) from
  // PROPOSAL_CATEGORIES in agent-prompts.ts; null for prompt tasks and
  // proposals created before this column existed.
  category     String?
  // Proposal priority ('critical'|'high'|'medium'|'low') and effort size
  // ('small'|'medium'|'large') from the generator prompt; null for prompt
  // tasks and proposals created before these columns existed.
  priority     String?
  effort       String?
  prompt       String?
  status       TaskStatus  @default(pending)
  branchName   String?
  prUrl        String?
  llmConfigId  String?
  // Per-task thinking-level override ('low'|'medium'|'high'|'max'); null =
  // use the LLM config's level. Stored as TEXT, validated by zod at the API.
  thinkingLevel String?
  // Image attachments sent with the prompt: [{name, dataUrl}] (max 3).
  attachments  Json?
  // Slugs of skills (Skill model) injected into the agent's system prompt
  // for this run; string[] stored as JSON. Null = repository default.
  skills       Json?
  // MCP servers attached to this run: { "<slug>": <config> } — materialized
  // as .mcp.json in the workdir before the agent starts.
  mcpServers   Json?
  // Per-folder AGENTS.md attachments: [{ "folder": "src/api", "content": "..." }]
  // — written into the workdir before the agent starts.
  agentsMdFiles Json?
  // Cumulative LLM token usage across run/review/fix jobs; seeds the
  // maxTokensPerRun budget so it spans the whole task, not a single job.
  llmTokensUsed Int        @default(0)
  // Cumulative prompt/completion split backing cost estimates; NULL for
  // tasks that ran before these columns existed (estimates cover new runs
  // only — no fabricated backfill).
  llmPromptTokens     Int?
  llmCompletionTokens Int?
  // Repo-relative paths changed on the task branch (string[] as JSON),
  // recorded by the worker after the push; null for old tasks or when the
  // diff failed (run-targets falls back to the repository platform).
  changedPaths Json?
  // Last human PR review comment id the address-review job completed
  // (namespaced, e.g. 'rc-1234' / 'note-42'); dedupes webhook redeliveries
  // and the pr-state-sync poll fallback.
  lastAddressedReviewId String?
  error        String?
  // Structured error code from the classifyError() mapping (errors.ts);
  // null for tasks that succeeded or haven't run yet. The frontend maps
  // these codes to user-friendly banners with actionable hints.
  errorCode    String?
  // Soft-archive timestamp: archived tasks are hidden from task lists but
  // never deleted; null = active.
  archivedAt   DateTime?
  // Start of the current pipeline session (run → review → merge gate counts
  // as ONE session). Set on the first active transition (running /
  // reviewing_code) after an idle or terminal status, so a rerun or a
  // re-review starts a new session while the steps inside one pipeline pass
  // share it. The console elapsed timer anchors here instead of createdAt —
  // previously reruns accumulated all previous sessions' wall time.
  sessionStartedAt DateTime?
  // Manual task chaining: when this task reaches 'done', the successor
  // pointed to by nextTaskId is auto-queued (started). A NULL successor =
  // no chaining. The link is cleared after firing so a rerun/re-merge does
  // not resurrect it (idempotent — the claim is pending-only).
  nextTaskId String?
  // Successor task set by nextTaskId. Null when this task has no manual
  // successor queued for it.
  nextTask   Task?  @relation("TaskNext", fields: [nextTaskId], references: [id], onDelete: SetNull)
  // Predecessor tasks (0+) that declared this task as their successor. A
  // task can be the successor of multiple predecessors, but each task has at
  // most one successor (nextTaskId).
  nextOf     Task[] @relation("TaskNext")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  llmConfig    LlmConfig?  @relation(fields: [llmConfigId], references: [id], onDelete: SetNull)
  events       TaskEvent[]

  @@index([repositoryId])
  @@index([status])
  @@index([llmConfigId])
}

model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  content     String
  tags        String[]
  source      String   @default("hermes")
  // 'skill' = injectable instruction pack; 'agents_md' = AGENTS.md template.
  kind        String   @default("skill")
  // Owner for user-created rows; NULL = global seeded entry readable by all.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// MCP server library entry: `config` holds the server fragment that is
// materialized into `.mcp.json` ("mcpServers": { "<slug>": <config> }) when
// selected during repository creation.
model McpServer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  config      Json
  tags        String[]
  source      String   @default("lemniscate")
  // Owner for user-created rows; NULL = global seeded entry readable by all.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TaskEvent {
  id        String        @id @default(cuid())
  taskId    String
  createdAt DateTime      @default(now())
  // 'agent_step'|'status'|'log'|'diff'|'retrospective' (see enum above).
  kind      TaskEventKind
  payload   Json
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// A paired local device (companion agent). Connects OUTBOUND to the
// WebSocket gateway (/api/devices/ws); the server pushes DeviceCommands
// through that tunnel. Only the sha256 of the device token is stored.
model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  // 'android'|'ios'|'desktop'|'web' — TEXT, validated by zod at the API.
  platform   String
  // Agent-reported capabilities: os, arch, agentVersion, dockerAvailable, …
  meta       Json?
  tokenHash  String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands   DeviceCommand[]

  @@index([userId])
}

// Short-lived (10 min) 6-char code the user creates in the UI; the device
// agent exchanges it for a device token via POST /api/devices/claim.
model DevicePairing {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  // 'run_web'|'run_ios'|'run_desktop'|'install_apk'|'build_android' — TEXT,
  // validated by zod at the API.
  type      String
  payload   Json
  // queued|sent|running|done|failed — TEXT, transitions via the WS gateway.
  status    String   @default("queued")
  result    Json?
  // Optional link to the task this command runs the result of (plain
  // column, no FK — the command must survive the task being touched).
  taskId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // Phase 10: lemcore run on whose behalf this command was dispatched
  // (null = UI-driven command from the devices page). Set by
  // lib/lemcore/device-tools.ts so the tool runner polls only its own row.
  lemcoreRunId String?

  @@index([deviceId])
  @@index([taskId])
}

// User-facing notification for async agent events (PR opened/merged/closed,
// run failed, token budget exceeded). Emitted by lib/notifications.ts from
// the existing event producers; read via GET /api/notifications and the
// TopNav bell. `kind` is TEXT ('pr_opened'|'pr_merged'|'pr_closed'|
// 'run_failed'|'budget_exceeded'), validated in lib/notifications.ts.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  taskId    String?
  prUrl     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Outbound notification channel (AGENTS.md §6 single home for delivery
// config): a webhook URL POSTed HMAC-signed JSON, or an email address
// reached via the optional SMTP_* env config. `channel` is TEXT
// ('webhook'|'email'), `events` the subscribed Notification.kind list —
// both validated in lib/notifications.ts. `secretEnc` holds the webhook
// HMAC secret, AES-256-GCM at rest via lib/crypto.ts (null for email).
model NotificationSetting {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  target    String
  secretEnc String?
  events    String[]
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([userId])
}

// Audit log of outbound delivery attempts: one row per (setting, event)
// enqueue, updated by the 'notification-delivery' BullMQ job with attempts,
// last HTTP status/error, and the terminal status ('queued'|'delivered'|
// 'failed'|'skipped'). `payload` is the exact JSON body sent.
model NotificationDelivery {
  id             String   @id @default(cuid())
  settingId      String
  notificationId String?
  event          String
  status         String   @default("queued")
  attempts       Int      @default(0)
  lastStatusCode Int?
  lastError      String?
  payload        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  setting        NotificationSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@index([settingId, createdAt])
}

enum ServiceStatus {
  stopped
  deploying
  online
  failed
}

enum DeployStatus {
  queued
  building
  starting
  checking
  online
  failed
}

// Where a Service is deployed. 'lemniscate' runs the app in a container on
// the platform's isolated apps network (Traefik-routed). 'vps' ships the
// build over SSH to the user's own server (referenced by vpsTargetId).
enum DeployTarget {
  lemniscate
  vps
}

// Reusable SSH connection profile for a user's own VPS. One profile can back
// several services. The credential (password or private key) is AES-256-GCM
// encrypted at rest and decrypted only into the SSH invocation at deploy time;
// it is never returned over the API.
model VpsTarget {
  id           String   @id @default(cuid())
  userId       String
  // Display name the user picks (e.g. "prod-box"); not used for routing.
  name         String
  host         String
  port         Int      @default(22)
  username     String
  // 'password' or 'key' — which credential secretEnc holds.
  authMethod   String   @default("password")
  // Encrypted password (authMethod='password') or PEM private key
  // (authMethod='key'). Never returned by the API (only hasSecret: true).
  secretEnc    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]

  @@index([userId])
}

// One deployable service per repository (v1), reachable at
// https://apps.grig-teo.space/<connection.username>/<name> when deployed on
// Lemniscate. Deployed by the worker's 'deploy-service' job — either into a
// container on the isolated apps network (lemniscate) or over SSH onto the
// user's VPS (vps). Traefik routes lemniscate services via the backend's
// dynamic-config endpoint.
model Service {
  id           String        @id @default(cuid())
  repositoryId String        @unique
  // URL slug segment (lowercase [a-z0-9-]); unique per connection username,
  // enforced in the route (the pair forms the public path).
  name         String
  // Container port the app listens on (Traefik target port).
  port         Int           @default(80)
  // Distinct host port published on a VPS (docker -p left side). Allocated
  // per-service so two apps with the same container port don't collide on the
  // host. Null for lemniscate services (Traefik routes by container name).
  hostPort     Int?
  // Per-service env vars, AES-256-GCM encrypted JSON {KEY: value}; decrypted
  // only into `docker run --env` at deploy time, never logged.
  envEnc       String?
  autoDeploy   Boolean       @default(true)
  status       ServiceStatus @default(stopped)
  // Currently routed container name (blue/green flip target); null when
  // nothing is deployed. For VPS deploys this holds the remote container name.
  activeContainer String?
  // Where the service is deployed. Defaults to 'lemniscate' (platform apps
  // network); 'vps' ships the build to the user's own server over SSH.
  deployTarget DeployTarget  @default(lemniscate)
  // Required when deployTarget='vps'; must be null otherwise (enforced in the
  // route). onDelete: SetNull so deleting a VPS profile falls services back to
  // the lemniscate target rather than orphaning them.
  vpsTargetId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  repository   Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  vpsTarget    VpsTarget?    @relation(fields: [vpsTargetId], references: [id], onDelete: SetNull)
  deployments  Deployment[]
}

model Deployment {
  id         String       @id @default(cuid())
  serviceId  String
  // Merge that triggered this deploy; null for manual redeploys.
  taskId     String?
  commitSha  String
  status     DeployStatus @default(queued)
  // Capped log tail (build/run/health output), ~50KB.
  log        String       @default("")
  createdAt  DateTime     @default(now())
  finishedAt DateTime?
  service    Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

// Executor scoreboard (AGENTS.md lemcore phases): one row per finished task
// run recording which executor ran it, the outcome, cumulative tokens and
// wall time. Settings → repository aggregates these per executor to compare
// hermes vs lemcore before making lemcore the default.
model ExecutorRunStat {
  id           String   @id @default(cuid())
  repositoryId String
  // 'hermes' | 'internal' | 'lemcore' — free-form string (executor ids are
  // validated in lib/agent-executor.ts, not at the DB layer).
  executor     String
  success      Boolean
  tokensUsed   Int      @default(0)
  wallTimeMs   Int      @default(0)
  createdAt    DateTime @default(now())
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
}

// ---------------------------------------------------------------------------
// gitlem — the internal minimal git host (AGENTS.md: one home per concern;
// the provider client lives in lib/git-providers/gitlem.ts).
// ---------------------------------------------------------------------------

// A gitlem account. Linked 1:1 to a lemniscate User (userId unique): the
// GitConnection row with provider 'gitlem' stores an encrypted PAT whose
// plaintext is also the GitlemUser.apiToken used by the git-over-HTTP
// endpoints (lib/gitlem-http.ts).
model GitlemUser {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  // scrypt hash in the `scrypt:N:r:p:salt:hash` format (lib/passwords.ts).
  passwordHash String
  // Plaintext PAT: gitlem is internal, and the same token authenticates both
  // the REST provider client and `git clone/push` over HTTP.
  apiToken     String   @unique
  userId       String?  @unique
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  repositories GitlemRepository[]
}

// One emailed registration code (6 digits, 10-minute TTL). Rows are deleted
// on consume/expiry; resending replaces the previous code.
model GitlemRegistrationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model GitlemRepository {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  // Repository metadata is stored as JSON documents (branches, files, PRs,
  // CI runs — see lib/gitlem-store.ts), so one row is the whole repo state.
  doc           String
  defaultBranch String   @default("main")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         GitlemUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])

// ─── lemcore phases 10–12 ────────────────────────────────────────────────

// Personal access token for the public API v1 (Phase 12). Only the sha256
// of the token is stored; the plaintext is shown once at creation.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  // Scope list (string[] as JSON): 'tasks:read'|'tasks:write'|'repos:read'.
  scopes     Json
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Outbound webhook endpoint registered per repository (Phase 12). Events:
// task.finished | pr.merged | run.failed. Deliveries are HMAC-signed
// (X-Lemniscate-Signature) and retried 5 times with backoff.
model Webhook {
  id           String            @id @default(cuid())
  repositoryId String
  url          String
  secretEnc    String
  events       Json
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([repositoryId])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  event          String
  payload        Json
  attempt        Int      @default(0)
  status         String   @default("pending") // pending|delivered|failed
  responseStatus Int?
  createdAt      DateTime @default(now())
  deliveredAt    DateTime?
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
}

// Organization (Phase 12): every user gets a personal org on migration;
// repositories and LLM configs can additionally attach to shared orgs with
// owner/maintainer/member role checks.
model Organization {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  kind         String       @default("shared") // personal|shared
  createdAt    DateTime     @default(now())
  members      OrgMember[]
  repositories Repository[]
  llmConfigs   LlmConfig[]
}

model OrgMember {
  id     String @id @default(cuid())
  orgId  String
  userId String
  // 'owner'|'maintainer'|'member' — TEXT, validated by zod at the API.
  role   String @default("member")
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

// SSO identity (Phase 12): a user may sign in via Google/GitHub OAuth next
// to the git-host login. The provider subject is unique.
model OauthIdentity {
  id               String   @id @default(cuid())
  userId           String
  provider         String // google|github
  providerSub      String
  email            String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
}

// Monthly usage meter (Phase 12 quotas). One row per user per calendar
// month (UTC); hard-stop checks read the live task sums, snapshots are
// written by the usage-meter job for the admin page.
model UsageSnapshot {
  id          String   @id @default(cuid())
  userId      String
  month       String // 'YYYY-MM'
  tasksRun    Int      @default(0)
  tokensUsed  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

// Marketplace listing (Phase 12): a published skill/tool/MCP config. The
// payload is stored in MinIO (listingKey); moderation = owner-approval
// queue only.
model MarketplaceListing {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  // 'skill'|'tool'|'mcp' — TEXT, validated by zod at the API.
  kind        String
  description String
  tags        String[]
  // MinIO object key holding the installable payload (JSON).
  payloadKey  String
  publisherId String
  // 'pending'|'approved'|'rejected' — only approved listings are public.
  status      String   @default("pending")
  installCount Int     @default(0)
  createdAt   DateTime @default(now())
  publisher   User     @relation("MarketplaceOwner", fields: [publisherId], references: [id], onDelete: Cascade)
  installs    MarketplaceInstall[]

  @@index([status, kind])
}

// One-click install record (Phase 12): which listing went into which repo.
model MarketplaceInstall {
  id           String             @id @default(cuid())
  listingId    String
  repositoryId String
  createdAt    DateTime           @default(now())
  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  repository   Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([listingId, repositoryId])
}
