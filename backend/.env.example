# Backend configuration — copy to `backend/.env` and fill in real values.
# `.env` is gitignored; never commit secrets.

# --- Server ---
PORT=3000
# Worker's health HTTP port (liveness /health + readiness /health/ready with
# BullMQ queue counts). Keep distinct from PORT; compose probes it for the
# worker container's healthcheck.
WORKER_HEALTH_PORT=3100
NODE_ENV=development

# --- URLs ---
FRONTEND_URL=http://localhost:8080
# Public URL of this backend (used for OAuth callbacks)
BACKEND_URL=http://localhost:3000
# Base URL for OAuth callbacks — the backend appends `/{provider}/callback`,
# so register e.g. http://localhost:3000/api/auth/github/callback at the provider.
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth

# --- Database (overridden by docker-compose; used for local dev) ---
DATABASE_URL=postgresql://lemniscate:lemniscate@localhost:5432/lemniscate

# --- Redis (BullMQ queue for the agent loop) ---
REDIS_URL=redis://localhost:6379

# --- MinIO (prompt-library object mirror: skills/, agents-md/, mcp-servers/) ---
# Optional: when unset, library mirroring is a no-op.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=lemniscate
MINIO_ROOT_PASSWORD=lemniscate-minio
MINIO_BUCKET=lemniscate-library
# APKs in the 'device-artifacts' bucket expire after this many days (lifecycle rule).
DEVICE_ARTIFACT_TTL_DAYS=7
# Max artifact uploads per device per rolling 24h; beyond this, uploads get a 429.
DEVICE_ARTIFACT_MAX_PER_DAY=20

# --- Workdir post-mortem archives ---
# Tarball of a finished task's workdir uploaded to MinIO (best-effort, for
# post-mortem inspection). Excludes .git/node_modules/build outputs.
#WORKDIR_ARCHIVE_ENABLED=true
#WORKDIR_ARCHIVE_BUCKET=lemniscate-workdir-archives
# Max post-exclusion workdir size in MB; larger workdirs are skipped and an
# 'archive_skipped_size' task event is recorded (default 100).
#WORKDIR_ARCHIVE_MAX_MB=100
# Days before workdir-archive objects expire (lifecycle rule; default 14).
#WORKDIR_ARCHIVE_TTL_DAYS=14

# --- Security ---
# Secret for signing session JWTs (min 32 chars; the placeholder is rejected)
JWT_SECRET=change-me-to-a-long-random-string
# 64-char hex (32 bytes) key for AES-256-GCM encryption of stored LLM API keys
ENCRYPTION_KEY=change-me-to-64-hex-chars
# SSRF guard escape hatch (default unset = private/loopback URLs are blocked
# for LLM baseUrl and self-hosted git connections). Set to true ONLY for
# local dev — it re-enables private LLM/git URLs (e.g. a local Ollama).
#ALLOW_PRIVATE_URLS=true
# Trust X-Forwarded-For from the frontend nginx so rate limits key on the
# real client IP (default true — correct for the Docker layout, where the
# backend is only reachable through nginx). Set to false ONLY if the backend
# is exposed directly to clients, where the header could be spoofed.
#TRUST_PROXY=false
# Max queued+running tasks per user (default 5)
#TASK_MAX_ACTIVE_PER_USER=5
# Shared secret guarding GET /metrics (Prometheus scrape of the API process).
# Send it as the x-metrics-token header or a Bearer token. Unset = the
# endpoint answers 503 (disabled). The worker's :3100/metrics needs no token
# but is only bound on the internal compose network.
#METRICS_TOKEN=

# --- GitHub OAuth App (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitVerse OAuth App ---
GITVERSE_CLIENT_ID=
GITVERSE_CLIENT_SECRET=
GITVERSE_BASE_URL=https://gitverse.ru

# --- GitLab OAuth App (optional) ---
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --- Gitee OAuth App (optional, https://gitee.com/oauth/applications) ---
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=

# --- Agent loop ---
# Directory (inside the worker container) where repos are cloned
AGENT_WORKDIR=/tmp/lemniscate-repos
# Default branch prefix for agent-generated PRs
AGENT_BRANCH_PREFIX=lemniscate/
# Parallel jobs in the worker (default 4)
AGENT_WORKER_CONCURRENCY=4

# --- Outbound email notifications (optional; webhooks need none of this) ---
# Unset SMTP_HOST = email channels are recorded as 'skipped' on delivery.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Lemniscate <notifications@example.com>

# --- Observability (see docs/observability.md) ---
# Bearer token guarding GET /metrics on the backend. Unset = the endpoint
# answers 404. Generate with: openssl rand -hex 32
#METRICS_TOKEN=
# Opt-in Sentry error reporting for the API and worker. Unset = the SDK is
# never loaded and reporting is a no-op. Events are scrubbed of secrets
# (JWT_SECRET, ENCRYPTION_KEY, DATABASE_URL, REDIS_URL) before sending.
#SENTRY_DSN=
