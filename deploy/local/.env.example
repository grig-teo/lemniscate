# Lemniscate LOCAL instance configuration.
# scripts/install-local.sh copies this file to deploy/local/.env on first run
# and fills the secrets automatically. `.env` is gitignored — never commit it.

# Public URL where you open the UI. For pairing phones/devices on the same
# Wi-Fi, this must be reachable from them: use this machine's LAN IP,
# e.g. PUBLIC_URL=http://192.168.1.50:8280 (the installer prompts for it).
PUBLIC_URL=http://localhost:8280

# Host port the UI is served on (container port stays 80).
FRONTEND_PORT=8280

# --- Postgres (internal to the compose network, not exposed on the host) ---
POSTGRES_USER=lemniscate
POSTGRES_PASSWORD=change-me-generated-by-install
POSTGRES_DB=lemniscate

# --- MinIO (internal only: prompt-library object mirror) ---
MINIO_ROOT_USER=lemniscate
MINIO_ROOT_PASSWORD=change-me-generated-by-install
MINIO_BUCKET=lemniscate-library

# --- Security (both generated by the installer) ---
# Secret for signing session JWTs (min 32 chars).
JWT_SECRET=change-me-generated-by-install
# 64-char hex (32 bytes) key for AES-256-GCM encryption of stored LLM API keys.
ENCRYPTION_KEY=change-me-generated-by-install

# Allow private/loopback URLs for LLM baseUrl and git connections
# (e.g. a local Ollama or a LAN git server). Local instances usually want
# this on; set to false to restore the strict SSRF guard.
ALLOW_PRIVATE_URLS=true

# --- Optional OAuth apps (one-click git host login) ---
# Not required: PAT git connections and LLM configs are created in the UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITVERSE_CLIENT_ID=
GITVERSE_CLIENT_SECRET=
